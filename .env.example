# Folder the server is allowed to manage. Nothing outside it is ever touched.
PDF_ROOT=./data/pdfs
# Where the Lucene index is stored (safe to delete; it is rebuilt on demand).
LUCENE_INDEX_PATH=./index
LOG_LEVEL=INFO
# HTTP server (python -m app.main). Keep 127.0.0.1 unless you add authentication.
HOST=127.0.0.1
PORT=8765

# JDK 17+ folder. Needed because MCP clients start this server with a minimal environment.
# JAVA_HOME=C:/Program Files/Eclipse Adoptium/jdk-17.0.19.10-hotspot
