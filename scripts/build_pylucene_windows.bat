@echo off
REM Builds/installs PyLucene 9.12.0 into the project's virtualenv on Windows (verified: Python 3.11, JDK 17, VS 2022).
REM Prerequisites: Visual Studio 2022 C++ build tools, JDK 17+ (JAVA_HOME set), project venv with `pip install setuptools`.
REM Steps done once by hand before running this script (see README, "Installing PyLucene"):
REM   1. Extract pylucene-9.12.0-src.tar.gz to a SHORT path (e.g. C:\pl): Windows MAX_PATH breaks the build otherwise.
REM   2. cd C:\pl\lucene-java-9.12.0 && gradlew.bat collectRuntimeJars
REM   3. pip install --no-build-isolation C:\pl\jcc
REM Usage:  scripts\build_pylucene_windows.bat  [build|install]    (run "build" first, then "install")
setlocal
if "%PYLUCENE_SRC%"=="" set PYLUCENE_SRC=C:\pl
if "%VENV_PYTHON%"=="" set VENV_PYTHON=%~dp0..\.venv\Scripts\python.exe
set ACTION=--%1
if "%1"=="" set ACTION=--build
call "C:\Program Files\Microsoft Visual Studio\2022\Community\VC\Auxiliary\Build\vcvars64.bat" >nul
set JCC_JDK=%JAVA_HOME%
REM NOGDI: the Windows ERROR macro (wingdi.h) clashes with java.lang.System.Logger.Level.ERROR.
set CL=/DNOGDI
cd /d %PYLUCENE_SRC%
"%VENV_PYTHON%" -m jcc --find-jvm-dll server --jar lucene-java-9.12.0\lucene\core\build\runtimeJars\lucene-core-9.12.0-SNAPSHOT.jar --jar lucene-java-9.12.0\lucene\analysis\common\build\runtimeJars\lucene-analysis-common-9.12.0-SNAPSHOT.jar --jar lucene-java-9.12.0\lucene\backward-codecs\build\runtimeJars\lucene-backward-codecs-9.12.0-SNAPSHOT.jar --jar lucene-java-9.12.0\lucene\classification\build\runtimeJars\lucene-classification-9.12.0-SNAPSHOT.jar --jar lucene-java-9.12.0\lucene\codecs\build\runtimeJars\lucene-codecs-9.12.0-SNAPSHOT.jar --jar lucene-java-9.12.0\lucene\expressions\build\runtimeJars\lucene-expressions-9.12.0-SNAPSHOT.jar --jar lucene-java-9.12.0\lucene\extensions\build\runtimeJars\lucene-extensions-9.12.0-SNAPSHOT.jar --jar lucene-java-9.12.0\lucene\facet\build\runtimeJars\lucene-facet-9.12.0-SNAPSHOT.jar --jar lucene-java-9.12.0\lucene\grouping\build\runtimeJars\lucene-grouping-9.12.0-SNAPSHOT.jar --jar lucene-java-9.12.0\lucene\highlighter\build\runtimeJars\lucene-highlighter-9.12.0-SNAPSHOT.jar --jar lucene-java-9.12.0\lucene\join\build\runtimeJars\lucene-join-9.12.0-SNAPSHOT.jar --jar lucene-java-9.12.0\lucene\analysis\kuromoji\build\runtimeJars\lucene-analysis-kuromoji-9.12.0-SNAPSHOT.jar --jar lucene-java-9.12.0\lucene\memory\build\runtimeJars\lucene-memory-9.12.0-SNAPSHOT.jar --jar lucene-java-9.12.0\lucene\misc\build\runtimeJars\lucene-misc-9.12.0-SNAPSHOT.jar --jar lucene-java-9.12.0\lucene\monitor\build\runtimeJars\lucene-monitor-9.12.0-SNAPSHOT.jar --jar lucene-java-9.12.0\lucene\analysis\nori\build\runtimeJars\lucene-analysis-nori-9.12.0-SNAPSHOT.jar --jar lucene-java-9.12.0\lucene\queries\build\runtimeJars\lucene-queries-9.12.0-SNAPSHOT.jar --jar lucene-java-9.12.0\lucene\queryparser\build\runtimeJars\lucene-queryparser-9.12.0-SNAPSHOT.jar --jar lucene-java-9.12.0\lucene\sandbox\build\runtimeJars\lucene-sandbox-9.12.0-SNAPSHOT.jar --jar lucene-java-9.12.0\lucene\spatial3d\build\runtimeJars\lucene-spatial3d-9.12.0-SNAPSHOT.jar --jar lucene-java-9.12.0\lucene\analysis\stempel\build\runtimeJars\lucene-analysis-stempel-9.12.0-SNAPSHOT.jar --jar lucene-java-9.12.0\lucene\suggest\build\runtimeJars\lucene-suggest-9.12.0-SNAPSHOT.jar --use_full_names --include lucene-java-9.12.0\lucene\expressions\build\runtimeJars\antlr4-runtime-4.11.1.jar --include lucene-java-9.12.0\lucene\expressions\build\runtimeJars\asm-7.2.jar --include lucene-java-9.12.0\lucene\expressions\build\runtimeJars\asm-commons-7.2.jar --package java.lang java.lang.System java.lang.Runtime --package java.util java.util.Arrays java.util.Collections java.util.HashMap java.util.HashSet java.util.TreeSet java.lang.IllegalStateException java.lang.IndexOutOfBoundsException java.util.NoSuchElementException java.text.SimpleDateFormat java.text.DecimalFormat java.text.Collator --package java.util.concurrent java.util.concurrent.Executors --package java.util.function --package java.util.regex --package java.io java.io.StringReader --package java.nio.file java.nio.file.Path java.nio.file.Files java.nio.file.Paths --package org.antlr.v4.runtime --package org.antlr.v4.runtime.atn --exclude org.apache.lucene.sandbox.queries.regex.JakartaRegexpCapabilities --exclude org.apache.regexp.RegexpTunnel --exclude org.apache.lucene.misc.store.WindowsDirectory --exclude org.apache.lucene.misc.store.NativePosixUtil --exclude module-info --python lucene --mapping org.apache.lucene.document.Document "get:(Ljava/lang/String;)Ljava/lang/String;" --mapping java.util.Properties "getProperty:(Ljava/lang/String;)Ljava/lang/String;" --sequence java.util.AbstractCollection "size:()I" -:- --sequence java.util.AbstractList -:- "get:(I)Ljava/lang/Object;" org.apache.lucene.index.IndexWriter:getReader org.apache.lucene.analysis.Tokenizer:input --version 9.12.0 --module python/collections.py --module python/ICUNormalizer2Filter.py --module python/ICUFoldingFilter.py --module python/ICUTransformFilter.py --files 8 %ACTION%
echo exit=%errorlevel%

